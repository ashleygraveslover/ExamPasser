{
  "manifest_version": 3,
  "name": "ExamPasser Experiments",
  "version": "1.0.4",
  "description": "Analyze the visible area of the current tab with Gemini.",
  "permissions": ["activeTab", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "quickpeek-ai-experiments@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "action": {
    "default_title": "ExamPasser Experiments",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png" },
    "default_popup": "popup.html"
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "commands": {
    "analyze-screen": { "suggested_key": { "default": "Alt+Q" }, "description": "Анализировать область экрана" },
    "analyze-screen-safe": { "suggested_key": { "default": "Alt+Shift+Q" }, "description": "Анализировать область экрана (альтернативная клавиша)" },
    "uninstall-extension": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Удалить ExamPasser" }
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
